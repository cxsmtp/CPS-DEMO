    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.7",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
