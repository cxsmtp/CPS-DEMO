# Nexa Commerce shopping assistant - runtime configuration.
#
# SECRETS chain surface (NX-12). The values below are secret-SHAPED so the
# Checkmarx secret-detection engine fingerprints them. They are non-functional
# placeholders committed to the repo - which is exactly the mistake the engine
# exists to catch: live-looking credentials in version control.

# NX-12 F1 - AWS access key pair (secret-detection: aws_access_key)
AWS_ACCESS_KEY_ID=AKIA5HEXAMPLE7NEXAQC
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# NX-12 F2 - JWT signing secret (secret-detection: jwt_secret)
NEXA_JWT_SIGNING_SECRET=nexa-auth-service-passphrase-2026-do-not-ship

# NX-12 F3 - database URL with inline credentials (secret-detection: database_url)
NEXA_DATABASE_URL=postgres://nexa_ops:Op3rations-Seed-2026!@catalog-db.internal:5432/nexa

# NX-12 F4 - generic API token (secret-detection: token)
NEXA_CATALOG_API_TOKEN=nxa_live_8f2c1d6b9e4a7350c1f8d2b6e9a4c7f0
